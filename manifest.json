{
  "manifest_version": 3,
  "name": "MediaFlow Pro - Captura & Conversor de Mídia",
  "version": "1.0.0",
  "description": "Extensão avançada de captura, conversão offline (WASM) e download de mídias com motor duplo e suporte a yt-dlp.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MediaFlow Pro"
  },
  "permissions": [
    "offscreen",
    "storage",
    "activeTab",
    "tabs",
    "downloads",
    "nativeMessaging",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["welcome.html", "offscreen.html", "style.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
